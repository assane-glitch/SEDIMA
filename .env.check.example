# Variables utilisees uniquement par scripts/check-connections.mjs.
# Copier en .env.check.local (ou ajouter a .env.local). Ne pas importer dans Vercel :
# les noms VERCEL_* y sont reserves.

# Chaine de connexion Postgres (Supabase > Project Settings > Database), optionnel
DATABASE_URL=
# Token personnel Vercel (Account Settings > Tokens)
VERCEL_TOKEN=
# Identifiant du projet Vercel (project Settings > General > Project ID), optionnel
VERCEL_PROJECT_ID=
# Token personnel GitHub, scope repo
GITHUB_TOKEN=
GITHUB_REPO=assane-glitch/SEDIMA
