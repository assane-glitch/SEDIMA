# Copier en .env.local et remplir. Ne jamais committer .env.local.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Optionnel : cle service_role (serveur uniquement, jamais cote client)
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : chaine de connexion Postgres (Project Settings > Database)
DATABASE_URL=

# --- Vercel (Account Settings > Tokens) ---
VERCEL_TOKEN=
# Optionnel : identifiant du projet Vercel lie a ce depot
VERCEL_PROJECT_ID=

# --- GitHub (token personnel, scope repo) ---
GITHUB_TOKEN=
GITHUB_REPO=assane-glitch/SEDIMA
