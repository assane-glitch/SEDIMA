# Variables de l'application. Copier en .env.local et remplir. Ne jamais committer .env.local.
# Vercel importe ce fichier automatiquement : ne mettre ici que ce que l'application deploie.

# URL racine du projet, sans suffixe /rest/v1/ (Supabase > Settings > Data API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Cle "publishable" sb_publishable_... (Supabase > Settings > API Keys)
SUPABASE_ANON_KEY=
# Cle secrete sb_secret_... : serveur uniquement, environnement Production seulement sur Vercel
SUPABASE_SERVICE_ROLE_KEY=
